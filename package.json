{
  "name": "free-museums-paris",
  "version": "1.0.0",
  "description": "Map PWA of free museums and monuments in Paris & Île-de-France",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/travel-eu/free-museums-paris.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-rtl-plugin.mjs",
    "update-data": "tsx scripts/update-parisjetaime.ts",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@mapbox/mapbox-gl-rtl-text": "^0.4.0",
    "i18next": "^25.3.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "maplibre-gl": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.6.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.0",
    "cheerio": "^1.1.0",
    "sharp": "^0.34.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}

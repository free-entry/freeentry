{
  "name": "free-museums-france",
  "version": "1.0.0",
  "description": "Map PWA of free museums and monuments in France, Italy and Belgium",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/travel-eu/free-museums-france.git"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:it": "COUNTRY=it astro dev",
    "dev:be": "COUNTRY=be astro dev",
    "build": "astro check && tsx scripts/build-image-variants.ts && astro build",
    "build:it": "COUNTRY=it astro check && COUNTRY=it tsx scripts/build-image-variants.ts && COUNTRY=it astro build",
    "build:be": "COUNTRY=be astro check && COUNTRY=be tsx scripts/build-image-variants.ts && COUNTRY=be astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-rtl-plugin.mjs",
    "update-data": "tsx scripts/update-parisjetaime.ts",
    "update:rules": "tsx scripts/update-parisjetaime.ts",
    "update:wikidata": "tsx scripts/enrich-wikidata.ts",
    "update:images": "tsx scripts/enrich-images.ts",
    "update:all": "npm run update:rules && npm run update:wikidata && tsx scripts/check-wikidata.ts --write && npm run update:images && tsx scripts/check-datagouv.ts --write && npm run check:freshness",
    "check:freshness": "tsx scripts/check-freshness.ts",
    "check:wikidata": "tsx scripts/check-wikidata.ts",
    "check:images": "tsx scripts/check-images.ts",
    "check:datagouv": "tsx scripts/check-datagouv.ts",
    "check:osm-hours": "tsx scripts/check-osm-hours.ts",
    "check:cmn": "tsx scripts/check-cmn.ts",
    "check:data": "npm run check:freshness && npm run check:wikidata && npm run check:images && npm run check:datagouv",
    "icons": "tsx scripts/generate-icons.ts",
    "images:variants": "tsx scripts/build-image-variants.ts"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@mapbox/mapbox-gl-rtl-text": "^0.4.0",
    "i18next": "^25.3.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "maplibre-gl": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.6.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^4.4.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.18.2",
    "cheerio": "^1.1.0",
    "sharp": "^0.34.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0"
  }
}

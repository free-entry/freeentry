---
import HubPage from '@/components/HubPage.astro';
import { LOCALES, type Locale } from '@/lib/i18n';

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== 'en').map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
---

<HubPage kind="index" locale={locale} />

---
import HubPage from '@/components/HubPage.astro';
import { COUNTRY } from '@/countries';
import { buildHubIndex } from '@/lib/hubs';
import { LOCALES, type Locale } from '@/lib/i18n';
import { getStaticMuseums } from '@/lib/staticData';

export function getStaticPaths() {
  const hubs = buildHubIndex(getStaticMuseums(), COUNTRY);
  return LOCALES.filter((locale) => locale !== 'en').flatMap((locale) =>
    hubs.categories.map(({ slug }) => ({
      params: { locale, category: slug },
      props: { locale, slug },
    })),
  );
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
---

<HubPage kind="category" locale={locale} slug={slug} />

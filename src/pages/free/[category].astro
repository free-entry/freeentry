---
import HubPage from '@/components/HubPage.astro';
import { COUNTRY } from '@/countries';
import { buildHubIndex } from '@/lib/hubs';
import { getStaticMuseums } from '@/lib/staticData';

export function getStaticPaths() {
  const hubs = buildHubIndex(getStaticMuseums(), COUNTRY);
  return hubs.categories.map(({ slug }) => ({ params: { category: slug }, props: { slug } }));
}

const { slug } = Astro.props;
---

<HubPage kind="category" locale="en" slug={slug} />

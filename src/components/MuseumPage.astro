---
import type { Museum } from '@/lib/types';
import type { Locale } from '@/lib/i18n';
import { COUNTRY } from '@/countries';
import {
  createStaticI18n,
  getStaticMuseumContent,
  getStaticNotes,
} from '@/lib/staticData';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { museumSeo } from '@/lib/seo';
import DetailContent from './DetailContent';
import MuseumDateStatus from './MuseumDateStatus';

interface Props {
  museum: Museum;
  locale: Locale;
}

const { museum, locale } = Astro.props;
const i18n = createStaticI18n(locale);
const content = getStaticMuseumContent(museum.id, locale);
const notes = getStaticNotes(locale);
const seo = museumSeo(museum, content[museum.id], locale, i18n.t.bind(i18n));
const baseUrl = import.meta.env.BASE_URL;
const homeUrl = `${baseUrl}${locale === 'en' ? '' : `${locale}/`}`;
const mapUrl = `${homeUrl}?museum=${encodeURIComponent(museum.id)}`;
const ogImage = museum.image
  ? {
      url: `${COUNTRY.siteUrl}/${museum.image.file}`,
      width: 1200,
      height: 630,
      alt: content[museum.id]?.name ?? museum.name,
    }
  : undefined;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  lang={locale}
  canonicalPath={seo.canonicalPath}
  alternates={seo.alternates}
  ogType="place"
  ogImage={ogImage}
  jsonLd={seo.jsonLd}
>
  <main class="detailPage">
    <div class="dateIsland">
      <MuseumDateStatus museum={museum} locale={locale} client:idle />
    </div>
    <DetailContent
      museum={museum}
      content={content}
      notes={notes}
      locale={locale}
      t={i18n.t.bind(i18n)}
      baseUrl={baseUrl}
      backHref={homeUrl}
      mapHref={mapUrl}
    />
  </main>
</BaseLayout>

<style>
  .detailPage {
    width: min(100% - 2rem, 52rem);
    min-height: 100%;
    margin-inline: auto;
    padding-block: 1.25rem 3rem;
  }

  .dateIsland:empty {
    display: none;
  }
</style>
